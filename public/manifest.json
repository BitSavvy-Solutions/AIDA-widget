{
    "manifest_version": 3,
    "name": "AIDA Chat Assistant",
    "version": "1.0.0",
    "description": "Your personal AI assistant, always at your side",
    "permissions": ["sidePanel", "storage", "tabs", "activeTab", "scripting"],
    "host_permissions": [
      "<all_urls>",
      "https://aida-agentbackend-prod.graydune-dda4d1ba.canadaeast.azurecontainerapps.io/*",
      "https://aida-agentbackend-dev.graydune-dda4d1ba.canadaeast.azurecontainerapps.io/*",
      "https://aitutfunc.azurewebsites.net/*"
    ],
    "side_panel": {
      "default_path": "extension.html"
    },
    "sidebar_action": {
      "default_panel": "extension.html",
      "default_title": "AIDA"
    },
    "action": {
      "default_title": "Open AIDA",
      "default_icon": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
      }
    },
    "background": {
      "service_worker": "background.js"
    }
  }